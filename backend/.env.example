# Vault service (separate project). Local default: the vault API on :8080.
VAULT_URL=http://localhost:8080

# Consumer API key for ink-readable, created in the vault panel.
VAULT_APIKEY=your-consumer-apikey

# Set to "development" to read configuration from this file instead of Vault.
# When set to any other value (or unset), all VAULT_* variables above are required.
ENV=development

# Application (required when ENV=development)
# Bind address: use 0.0.0.0 so other containers can reach the API.
APP_BASE_URL=0.0.0.0
APP_PORT=8082

# Database (required when ENV=development)
DATABASE_URI=/app/data/ink-readable.db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ink-readable
DATABASE_USER=admin
DATABASE_PASSWORD=change-me
