{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ink and Readable",
  "version": "0.1.2",
  "identifier": "dev.inkreadable.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ink & Readable",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A calm, keyboard-first home for your Markdown notes.",
    "longDescription": "Ink & Readable is a split Markdown editor with live preview, vaults, Mermaid diagrams, KaTeX math and a Kanban planner.",
    "externalBin": ["binaries/ink-readable-api"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyMjI2OEM2ODM4QTVEMTAKUldRUVhZcUR4bWdpTW45c2c3M3lsa3lIVzVmc0hRRGFjeEtnTGhOK25YZVRobHorQllOOU80ekIK",
      "endpoints": [
        "https://github.com/AlvaroVFon/ink-readable/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
